{
  "name": "wise-one-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Wise One Enterprise API",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "setup:batch": "powershell -ExecutionPolicy Bypass -File ./scripts/finalize-batch.ps1",
    "smoke:sales-finance": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-sales-finance.ps1",
    "setup:operations-v2": "powershell -ExecutionPolicy Bypass -File ./scripts/finalize-operations-batch.ps1",
    "smoke:operations-v2": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-operations-v2.ps1",
    "setup:commercial-fiscal": "powershell -ExecutionPolicy Bypass -File ./scripts/finalize-commercial-fiscal.ps1",
    "smoke:commercial-fiscal": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-commercial-fiscal.ps1",
    "setup:treasury-finance-v2": "powershell -ExecutionPolicy Bypass -File ./scripts/finalize-treasury-finance-v2.ps1",
    "smoke:treasury-finance-v2": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-treasury-finance-v2.ps1",
    "setup:procurement-commercial-v2": "powershell -ExecutionPolicy Bypass -File ./scripts/finalize-procurement-commercial-v2.ps1",
    "smoke:procurement-commercial-v2": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-procurement-commercial-v2.ps1",
    "setup:logistics-commercial-v3": "powershell -ExecutionPolicy Bypass -File ./scripts/finalize-logistics-commercial-v3.ps1",
    "smoke:logistics-commercial-v3": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-logistics-commercial-v3.ps1",
    "setup:production-pcp-v1": "powershell -ExecutionPolicy Bypass -File ./scripts/finalize-production-pcp-v1.ps1",
    "smoke:production-pcp-v1": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-production-pcp-v1.ps1",
    "setup:crm-services-v1": "powershell -ExecutionPolicy Bypass -File ./scripts/finalize-crm-services-v1.ps1",
    "smoke:crm-services-v1": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-crm-services-v1.ps1",
    "setup:platform-hardening-v1": "powershell -ExecutionPolicy Bypass -File ./scripts/finalize-platform-hardening-v1.ps1",
    "regression": "powershell -ExecutionPolicy Bypass -File ./scripts/regression-platform-v1.ps1"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.0.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@scarf/scarf@1.4.0": true,
    "prisma@6.19.3": true,
    "bcrypt@6.0.0": true
  }
}
