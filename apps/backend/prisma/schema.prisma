generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  ARCHIVED
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  INACTIVE
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum SupplierType {
  INDIVIDUAL
  BUSINESS
}

model Company {
  id        String       @id @default(uuid()) @db.Uuid
  legalName String       @map("legal_name")
  tradeName String?      @map("trade_name")
  document  String       @unique
  email     String?
  phone     String?
  logoUrl   String?      @map("logo_url")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  branches           Branch[]
  users              User[]
  roles              Role[]
  permissions        Permission[]
  sessions           Session[]
  auditLogs          AuditLog[]
  customers          Customer[]
  suppliers          Supplier[]
  products           Product[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]

  @@map("companies")
}

model Branch {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  name      String
  code      String
  document  String?
  email     String?
  phone     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  users              User[]
  auditLogs          AuditLog[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("branches")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  branchId     String?    @map("branch_id") @db.Uuid
  name         String
  email        String
  passwordHash String     @map("password_hash")
  status       UserStatus @default(PENDING)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles          UserRole[]
  sessions           Session[]
  auditLogs          AuditLog[]          @relation("AuditActor")

  @@unique([companyId, email])
  @@index([companyId, status])
  @@index([branchId])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles UserRole[]
  grants    RolePermission[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  code        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  grants  RolePermission[]

  @@unique([companyId, code])
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  branch             Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor              User?               @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, entity, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Customer {
  id                    String       @id @default(uuid()) @db.Uuid
  companyId             String       @map("company_id") @db.Uuid
  type                  CustomerType @default(INDIVIDUAL)
  name                  String
  legalName             String?      @map("legal_name")
  tradeName             String?      @map("trade_name")
  document              String
  stateRegistration     String?      @map("state_registration")
  municipalRegistration String?      @map("municipal_registration")
  email                 String?
  phone                 String?
  mobile                String?
  notes                 String?
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]

  @@unique([companyId, document])
  @@index([companyId, name])
  @@index([companyId, status])
  @@map("customers")
}

model Supplier {
  id                    String       @id @default(uuid()) @db.Uuid
  companyId             String       @map("company_id") @db.Uuid
  type                  SupplierType @default(BUSINESS)
  name                  String
  legalName             String?      @map("legal_name")
  tradeName             String?      @map("trade_name")
  document              String
  stateRegistration     String?      @map("state_registration")
  municipalRegistration String?      @map("municipal_registration")
  email                 String?
  phone                 String?
  mobile                String?
  notes                 String?
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]

  @@unique([companyId, document])
  @@index([companyId, name])
  @@index([companyId, status])
  @@map("suppliers")
}

enum ProductUnit {
  UN
  KG
  G
  L
  ML
  CX
  PC
  M
  M2
  M3
}

model Product {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @map("company_id") @db.Uuid
  name         String
  description  String?
  sku          String
  barcode      String?
  unit         ProductUnit  @default(UN)
  costPrice    Decimal      @default(0) @map("cost_price") @db.Decimal(15, 4)
  salePrice    Decimal      @default(0) @map("sale_price") @db.Decimal(15, 4)
  minimumStock Decimal      @default(0) @map("minimum_stock") @db.Decimal(15, 4)
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, name])
  @@index([companyId, status])
  @@map("products")
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

model InventoryBalance {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(15, 4)
  reserved  Decimal  @default(0) @db.Decimal(15, 4)
  available Decimal  @default(0) @db.Decimal(15, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  user       User?     @relation(fields: [userId], references: [id])
  userId     String?   @db.Uuid
  auditLog   AuditLog? @relation(fields: [auditLogId], references: [id])
  auditLogId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?   @db.Uuid

  @@unique([branchId, productId])
  @@index([companyId, productId])
  @@index([companyId, branchId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  companyId     String                @map("company_id") @db.Uuid
  branchId      String                @map("branch_id") @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(15, 4)
  previousQty   Decimal               @map("previous_qty") @db.Decimal(15, 4)
  currentQty    Decimal               @map("current_qty") @db.Decimal(15, 4)
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id")
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at")

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  user       User?     @relation(fields: [userId], references: [id])
  userId     String?   @db.Uuid
  auditLog   AuditLog? @relation(fields: [auditLogId], references: [id])
  auditLogId String?   @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?   @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?   @db.Uuid

  @@index([companyId, branchId, productId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("inventory_movements")
}
