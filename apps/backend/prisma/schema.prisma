generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  ARCHIVED
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  INACTIVE
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum SupplierType {
  INDIVIDUAL
  BUSINESS
}

enum ProductUnit {
  UN
  KG
  G
  L
  ML
  CX
  PC
  M
  M2
  M3
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum ProcurementStatus {
  DRAFT
  OPEN
  PARTIAL
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum FinancialEntryType {
  RECEIVABLE
  PAYABLE
}

enum FinancialEntryStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  BANK_TRANSFER
  BOLETO
  OTHER
}

enum TreasuryAccountType {
  BANK
  CASH
}

enum TreasuryMovementType {
  CREDIT
  DEBIT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum ChartAccountNature {
  REVENUE
  EXPENSE
  ASSET
  LIABILITY
  EQUITY
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum InventoryTransferStatus {
  CONFIRMED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIAL
  FULFILLED
  CONVERTED
  CANCELLED
}

enum ShipmentStatus {
  DRAFT
  PICKING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CustomerReturnStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum ProductionOrderStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FiscalDocumentType {
  NFE
  NFCE
}

enum FiscalDocumentStatus {
  DRAFT
  AUTHORIZED
  CANCELLED
  REJECTED
}

model Company {
  id        String       @id @default(uuid()) @db.Uuid
  legalName String       @map("legal_name")
  tradeName String?      @map("trade_name")
  document  String       @unique
  email     String?
  phone     String?
  logoUrl   String?      @map("logo_url")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  branches             Branch[]
  users                User[]
  roles                Role[]
  permissions          Permission[]
  sessions             Session[]
  auditLogs            AuditLog[]
  customers            Customer[]
  suppliers            Supplier[]
  products             Product[]
  inventoryBalances    InventoryBalance[]
  inventoryMovements   InventoryMovement[]
  purchases            Purchase[]
  sales                Sale[]
  financialEntries     FinancialEntry[]
  productCategories    ProductCategory[]
  inventoryTransfers   InventoryTransfer[]
  paymentTerms         PaymentTerm[]
  quotes               Quote[]
  salesOrders          SalesOrder[]
  fiscalDocuments      FiscalDocument[]
  chartAccounts        ChartAccount[]
  costCenters          CostCenter[]
  treasuryAccounts     TreasuryAccount[]
  treasuryMovements    TreasuryMovement[]
  treasuryTransfers    TreasuryTransfer[]
  financialSettlements FinancialSettlement[]
  cashSessions         CashSession[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  goodsReceipts        GoodsReceipt[]
  carriers             Carrier[]
  shipments            Shipment[]
  customerReturns      CustomerReturn[]
  billsOfMaterial      BillOfMaterial[]
  productionOrders     ProductionOrder[]

  @@map("companies")
}

model Branch {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  name      String
  code      String
  document  String?
  email     String?
  phone     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  users              User[]
  auditLogs          AuditLog[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  purchases          Purchase[]
  sales              Sale[]
  financialEntries   FinancialEntry[]
  outgoingTransfers  InventoryTransfer[] @relation("TransferFromBranch")
  incomingTransfers  InventoryTransfer[] @relation("TransferToBranch")
  quotes             Quote[]
  salesOrders        SalesOrder[]
  fiscalDocuments    FiscalDocument[]
  treasuryAccounts   TreasuryAccount[]
  treasuryMovements  TreasuryMovement[]
  cashSessions       CashSession[]
  purchaseRequests   PurchaseRequest[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  shipments          Shipment[]
  customerReturns    CustomerReturn[]
  productionOrders   ProductionOrder[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("branches")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  branchId     String?    @map("branch_id") @db.Uuid
  name         String
  email        String
  passwordHash String     @map("password_hash")
  status       UserStatus @default(PENDING)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles UserRole[]
  sessions  Session[]
  auditLogs AuditLog[] @relation("AuditActor")

  @@unique([companyId, email])
  @@index([companyId, status])
  @@index([branchId])
  @@map("users")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles UserRole[]
  grants    RolePermission[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  code        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  grants  RolePermission[]

  @@unique([companyId, code])
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor   User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, entity, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Customer {
  id                    String       @id @default(uuid()) @db.Uuid
  companyId             String       @map("company_id") @db.Uuid
  type                  CustomerType @default(INDIVIDUAL)
  name                  String
  legalName             String?      @map("legal_name")
  tradeName             String?      @map("trade_name")
  document              String
  stateRegistration     String?      @map("state_registration")
  municipalRegistration String?      @map("municipal_registration")
  email                 String?
  phone                 String?
  mobile                String?
  notes                 String?
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sales            Sale[]
  financialEntries FinancialEntry[]
  purchaseOrders   PurchaseOrder[]
  quotes           Quote[]
  salesOrders      SalesOrder[]
  fiscalDocuments  FiscalDocument[]
  shipments        Shipment[]
  customerReturns  CustomerReturn[]

  @@unique([companyId, document])
  @@index([companyId, name])
  @@index([companyId, status])
  @@map("customers")
}

model Supplier {
  id                    String       @id @default(uuid()) @db.Uuid
  companyId             String       @map("company_id") @db.Uuid
  type                  SupplierType @default(BUSINESS)
  name                  String
  legalName             String?      @map("legal_name")
  tradeName             String?      @map("trade_name")
  document              String
  stateRegistration     String?      @map("state_registration")
  municipalRegistration String?      @map("municipal_registration")
  email                 String?
  phone                 String?
  mobile                String?
  notes                 String?
  status                RecordStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchases        Purchase[]
  financialEntries FinancialEntry[]
  purchaseOrders   PurchaseOrder[]

  @@unique([companyId, document])
  @@index([companyId, name])
  @@index([companyId, status])
  @@map("suppliers")
}

model Product {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @map("company_id") @db.Uuid
  categoryId   String?      @map("category_id") @db.Uuid
  name         String
  description  String?
  sku          String
  barcode      String?
  unit         ProductUnit  @default(UN)
  costPrice    Decimal      @default(0) @map("cost_price") @db.Decimal(15, 4)
  salePrice    Decimal      @default(0) @map("sale_price") @db.Decimal(15, 4)
  minimumStock Decimal      @default(0) @map("minimum_stock") @db.Decimal(15, 4)
  ncm          String?
  cest         String?
  fiscalOrigin String?      @map("fiscal_origin")
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")

  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inventoryBalances    InventoryBalance[]
  inventoryMovements   InventoryMovement[]
  purchaseItems        PurchaseItem[]
  saleItems            SaleItem[]
  category             ProductCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transferItems        InventoryTransferItem[]
  quoteItems           QuoteItem[]
  salesOrderItems      SalesOrderItem[]
  fiscalItems          FiscalDocumentItem[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]
  shipmentItems        ShipmentItem[]
  customerReturnItems  CustomerReturnItem[]
  manufacturedBoms     BillOfMaterial[]        @relation("BomFinishedProduct")
  bomComponents        BillOfMaterialItem[]    @relation("BomComponent")
  productionProducts   ProductionOrder[]       @relation("ProductionFinishedProduct")
  productionComponents ProductionConsumption[] @relation("ProductionComponent")
  productionOutputs    ProductionOutput[]      @relation("ProductionOutputProduct")

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, name])
  @@index([companyId, status])
  @@index([categoryId])
  @@map("products")
}

model InventoryBalance {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(15, 4)
  reserved  Decimal  @default(0) @db.Decimal(15, 4)
  available Decimal  @default(0) @db.Decimal(15, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([branchId, productId])
  @@index([companyId, productId])
  @@index([companyId, branchId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  companyId     String                @map("company_id") @db.Uuid
  branchId      String                @map("branch_id") @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(15, 4)
  previousQty   Decimal               @map("previous_qty") @db.Decimal(15, 4)
  currentQty    Decimal               @map("current_qty") @db.Decimal(15, 4)
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id")
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([companyId, branchId, productId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model Purchase {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  branchId    String         @map("branch_id") @db.Uuid
  supplierId  String         @map("supplier_id") @db.Uuid
  number      String
  status      PurchaseStatus @default(DRAFT)
  issueDate   DateTime       @default(now()) @map("issue_date")
  totalAmount Decimal        @default(0) @map("total_amount") @db.Decimal(15, 4)
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items    PurchaseItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([supplierId])
  @@index([branchId])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(uuid()) @db.Uuid
  purchaseId  String   @map("purchase_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  quantity    Decimal  @db.Decimal(15, 4)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(15, 4)
  totalAmount Decimal  @map("total_amount") @db.Decimal(15, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Sale {
  id            String     @id @default(uuid()) @db.Uuid
  companyId     String     @map("company_id") @db.Uuid
  branchId      String     @map("branch_id") @db.Uuid
  customerId    String     @map("customer_id") @db.Uuid
  paymentTermId String?    @map("payment_term_id") @db.Uuid
  number        String
  status        SaleStatus @default(DRAFT)
  issueDate     DateTime   @default(now()) @map("issue_date")
  totalAmount   Decimal    @default(0) @map("total_amount") @db.Decimal(15, 4)
  notes         String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items           SaleItem[]
  paymentTerm     PaymentTerm?     @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  salesOrder      SalesOrder?      @relation("SalesOrderSale")
  fiscalDocument  FiscalDocument?
  customerReturns CustomerReturn[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([customerId])
  @@index([branchId])
  @@index([paymentTermId])
  @@map("sales")
}

model SaleItem {
  id             String   @id @default(uuid()) @db.Uuid
  saleId         String   @map("sale_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  quantity       Decimal  @db.Decimal(15, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(15, 4)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 4)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(15, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model FinancialEntry {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  branchId          String               @map("branch_id") @db.Uuid
  type              FinancialEntryType
  status            FinancialEntryStatus @default(OPEN)
  description       String
  amount            Decimal              @db.Decimal(15, 4)
  paidAmount        Decimal              @default(0) @map("paid_amount") @db.Decimal(15, 4)
  dueDate           DateTime             @map("due_date")
  settledAt         DateTime?            @map("settled_at")
  paymentMethod     PaymentMethod?       @map("payment_method")
  installmentNumber Int                  @default(1) @map("installment_number")
  installmentCount  Int                  @default(1) @map("installment_count")
  customerId        String?              @map("customer_id") @db.Uuid
  supplierId        String?              @map("supplier_id") @db.Uuid
  chartAccountId    String?              @map("chart_account_id") @db.Uuid
  costCenterId      String?              @map("cost_center_id") @db.Uuid
  referenceType     String?              @map("reference_type")
  referenceId       String?              @map("reference_id")
  notes             String?
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer     Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier     Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  chartAccount ChartAccount?         @relation(fields: [chartAccountId], references: [id], onDelete: SetNull)
  costCenter   CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  settlements  FinancialSettlement[]

  @@unique([companyId, referenceType, referenceId, type, installmentNumber])
  @@index([companyId, type, status])
  @@index([companyId, dueDate])
  @@index([customerId])
  @@index([supplierId])
  @@index([chartAccountId])
  @@index([costCenterId])
  @@index([referenceType, referenceId])
  @@map("financial_entries")
}

model ProductCategory {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("product_categories")
}

model InventoryTransfer {
  id           String                  @id @default(uuid()) @db.Uuid
  companyId    String                  @map("company_id") @db.Uuid
  fromBranchId String                  @map("from_branch_id") @db.Uuid
  toBranchId   String                  @map("to_branch_id") @db.Uuid
  number       String
  status       InventoryTransferStatus @default(CONFIRMED)
  notes        String?
  confirmedAt  DateTime                @default(now()) @map("confirmed_at")
  cancelledAt  DateTime?               @map("cancelled_at")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fromBranch Branch                  @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch                  @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: Restrict)
  items      InventoryTransferItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id         String   @id @default(uuid()) @db.Uuid
  transferId String   @map("transfer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  quantity   Decimal  @db.Decimal(15, 4)
  createdAt  DateTime @default(now()) @map("created_at")

